<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#131B26"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Import Existing Kaspa Wallet"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WALLET LABEL"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etImportWalletName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1E293B"
        android:textColor="#FFFFFF"
        android:textColorHint="#64748B"
        android:paddingHorizontal="14dp"
        android:hint="e.g. Imported Vault"
        android:text="Imported Vault"
        android:textSize="14sp"
        android:layout_marginBottom="14dp" />

    <!-- Secret Input Header with Paste & QR Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="12/24-WORD SEED OR PRIVATE KEY"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPasteImport"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Paste"
            android:textColor="#70C7BA"
            android:textSize="11sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnScanImportQR"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="📷 Scan"
            android:textColor="#70C7BA"
            android:textSize="11sp"
            android:textAllCaps="false" />
    </LinearLayout>

    <EditText
        android:id="@+id/etImportSecret"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#1E293B"
        android:textColor="#FFFFFF"
        android:textColorHint="#64748B"
        android:padding="12dp"
        android:gravity="top|start"
        android:hint="Enter 12/24 secret words separated by spaces or 64-hex private key"
        android:textSize="13sp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NETWORK"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinnerImportNetwork"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1E293B"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VAULT PASSWORD"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etImportPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1E293B"
        android:textColor="#FFFFFF"
        android:textColorHint="#64748B"
        android:paddingHorizontal="14dp"
        android:hint="Password to encrypt local vault"
        android:inputType="textPassword"
        android:textSize="14sp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DERIVATION PATH (OPTIONAL)"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etImportDerivationPath"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#1E293B"
        android:textColor="#70C7BA"
        android:textColorHint="#64748B"
        android:paddingHorizontal="14dp"
        android:text="m/44'/111111'/0'/0/0"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitImport"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Import &amp; Restore Wallet"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:backgroundTint="#2A303C"
        app:cornerRadius="10dp" />

</LinearLayout>
