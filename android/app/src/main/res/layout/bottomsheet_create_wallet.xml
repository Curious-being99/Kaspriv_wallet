<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#131B26"
    android:padding="20dp">

    <!-- Header & Close Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvWizardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Create Kaspa Wallet"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStepIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 1 of 3"
            android:textColor="#70C7BA"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- STEP 1: Basic Info & Security -->
    <LinearLayout
        android:id="@+id/layoutStep1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WALLET LABEL"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etNewWalletName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1E293B"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:paddingHorizontal="14dp"
            android:hint="e.g. Primary Kaspa Vault"
            android:text="Kaspa Vault 1"
            android:textSize="14sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NETWORK"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerNewNetwork"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1E293B"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VAULT ENCRYPTION PASSWORD / PIN"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1E293B"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:paddingHorizontal="14dp"
            android:hint="Enter secure password"
            android:inputType="textPassword"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProceedToSeed"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Generate Secret Seed Phrase"
            android:textColor="#090D12"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#70C7BA"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- STEP 2: Seed Phrase Display & Backup -->
    <LinearLayout
        android:id="@+id/layoutStep2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ Write down these 12 secret recovery words in exact order. Store them in a secure physical location. Never share them with anyone."
            android:textColor="#FBBF24"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:background="#262315"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <!-- Seed Phrase Container Grid (Populated dynamically) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="#090D12"
            android:layout_marginBottom="12dp">
            
            <LinearLayout
                android:id="@+id/llSeedWordsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <!-- Text representation / Word chips -->
                <TextView
                    android:id="@+id/tvSeedWordsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#70C7BA"
                    android:textSize="14sp"
                    android:lineSpacingExtra="8dp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopySeed"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="📋 Copy"
                android:textColor="#94A3B8"
                android:textAllCaps="false"
                app:strokeColor="#334155"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleMaskSeed"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="👁️ Hide / Reveal"
                android:textColor="#94A3B8"
                android:textAllCaps="false"
                app:strokeColor="#334155"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbConfirmedBackup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I understand that losing my seed phrase means losing my funds forever."
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProceedToVerify"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Verify Seed Phrase"
            android:textColor="#090D12"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#70C7BA"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- STEP 3: Verification Challenge -->
    <LinearLayout
        android:id="@+id/layoutStep3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm your backup by entering the requested words:"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/tvVerifyLabel1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Word #3:"
            android:textColor="#70C7BA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etVerifyWord1"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#1E293B"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="12dp"
            android:hint="Type word"
            android:textColorHint="#64748B"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvVerifyLabel2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Word #7:"
            android:textColor="#70C7BA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etVerifyWord2"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#1E293B"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="12dp"
            android:hint="Type word"
            android:textColorHint="#64748B"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvVerifyLabel3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Word #11:"
            android:textColor="#70C7BA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etVerifyWord3"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#1E293B"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="12dp"
            android:hint="Type word"
            android:textColorHint="#64748B"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinalizeCreate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Complete Setup &amp; Activate Wallet"
            android:textColor="#090D12"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#70C7BA"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
