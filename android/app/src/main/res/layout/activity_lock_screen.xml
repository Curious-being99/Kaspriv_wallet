<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090D12"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Top Space -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Lock Icon / Shield -->
    <ImageView
        android:id="@+id/ivLockIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/splash"
        android:contentDescription="Vault Shield"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KasPriv Vault"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvLockPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter 4-digit PIN to unlock"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <!-- PIN Indicator Dots -->
    <LinearLayout
        android:id="@+id/llPinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <View
            android:id="@+id/dot1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/ic_launcher_background"
            android:backgroundTint="#334155" />

        <View
            android:id="@+id/dot2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/ic_launcher_background"
            android:backgroundTint="#334155" />

        <View
            android:id="@+id/dot3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/ic_launcher_background"
            android:backgroundTint="#334155" />

        <View
            android:id="@+id/dot4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/ic_launcher_background"
            android:backgroundTint="#334155" />
    </LinearLayout>

    <!-- Numeric Keypad Grid -->
    <GridLayout
        android:id="@+id/glKeypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        android:layout_gravity="center_horizontal">

        <!-- Row 1 -->
        <Button
            android:id="@+id/btnKey1"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="1"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#131B26" />

        <Button
            android:id="@+id/btnKey2"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="2"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#131B26" />

        <Button
            android:id="@+id/btnKey3"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="3"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#131B26" />

        <!-- Row 2 -->
        <Button
            android:id="@+id/btnKey4"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="4"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#131B26" />

        <Button
            android:id="@+id/btnKey5"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="5"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#131B26" />

        <Button
            android:id="@+id/btnKey6"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="6"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#131B26" />

        <!-- Row 3 -->
        <Button
            android:id="@+id/btnKey7"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="7"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#131B26" />

        <Button
            android:id="@+id/btnKey8"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="8"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#131B26" />

        <Button
            android:id="@+id/btnKey9"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="9"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#131B26" />

        <!-- Row 4 -->
        <Button
            android:id="@+id/btnBiometrics"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="🔒"
            android:textSize="20sp"
            android:textColor="#70C7BA"
            android:backgroundTint="#1E293B" />

        <Button
            android:id="@+id/btnKey0"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="0"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#131B26" />

        <Button
            android:id="@+id/btnKeyBackspace"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="⌫"
            android:textSize="20sp"
            android:textColor="#EF4444"
            android:backgroundTint="#1E293B" />
    </GridLayout>

    <!-- Bottom Space -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnForgotPin"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot PIN / Reset Vault"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp" />

</LinearLayout>
