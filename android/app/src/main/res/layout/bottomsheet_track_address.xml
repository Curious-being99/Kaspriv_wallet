<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#131B26"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Track Address (Watch-Only)"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monitor balances, UTXOs, and on-chain activity without storing or exposing private keys."
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ACCOUNT LABEL"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etTrackLabel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1E293B"
        android:textColor="#FFFFFF"
        android:textColorHint="#64748B"
        android:paddingHorizontal="14dp"
        android:hint="e.g. Cold Storage / Mining Address"
        android:text="Cold Storage"
        android:textSize="14sp"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="KASPA PUBLIC ADDRESS"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPasteTrack"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Paste"
            android:textColor="#70C7BA"
            android:textSize="11sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnScanTrackQR"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="📷 Scan"
            android:textColor="#70C7BA"
            android:textSize="11sp"
            android:textAllCaps="false" />
    </LinearLayout>

    <EditText
        android:id="@+id/etTrackAddress"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#1E293B"
        android:textColor="#70C7BA"
        android:textColorHint="#64748B"
        android:padding="12dp"
        android:gravity="top|start"
        android:hint="kaspa:qq... or kaspatest:qq..."
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NETWORK"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinnerTrackNetwork"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1E293B"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitTrack"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Add Watch-Only Tracker"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:backgroundTint="#334155"
        app:cornerRadius="10dp" />

</LinearLayout>
